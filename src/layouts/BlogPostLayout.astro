---
import type { CollectionEntry } from 'astro:content';
import { resolveFeaturedImage, resolveFeaturedImageAlt } from '../lib/blogImages';
import ArticleLayout from './ArticleLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate } = entry.data;
// Payload writes /media/... paths, media objects and bare bucket-root R2
// URLs; none of those resolve when passed straight to <img src>.
const featuredImage = resolveFeaturedImage(entry.data, entry.body);
const imageAlt = resolveFeaturedImageAlt(entry.data, entry.data.title);
---
<ArticleLayout
  title={title}
  description={description}
  image={featuredImage || '/images/2023/06/digitale-wekker.jpeg'}
  date={pubDate.toISOString()}
>
  <slot name="header" slot="header" />
  <slot />
  <slot name="footer" slot="footer" />
</ArticleLayout>
