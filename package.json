{
  "name": "interiorchick.nl",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:blog && astro dev",
    "build": "npm run prepare:blog && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "migrate": "python3 scripts/migrate-wordpress.py",
    "setup": "python3 scripts/setup-from-wp.py",
    "scrape:products": "python3 scripts/scrape-product-pages.py",
    "fix:blog-images": "python3 scripts/fix-blog-featured-images.py",
    "verify:links": "python3 scripts/verify-links.py",
    "prepare:blog": "node scripts/remove-spam-blog.mjs && node scripts/sanitize-blog.mjs && node scripts/validate-blog.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "astro": "^7.0.3"
